#!/usr/bin/env python3
"""Project-local Graphify: deterministic analysis and honest usage counters."""
import collections
import datetime
import json
import pathlib
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
CLI = ROOT / "work/tools/graphify/bin/graphify"
OUTPUT = ROOT / "work/graphify"
GRAPH = OUTPUT / "graphify-out/graph.json"
USAGE = OUTPUT / "usage.jsonl"


def run(operation, arguments):
    OUTPUT.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()
    completed = subprocess.run([str(CLI), *arguments], cwd=ROOT)
    with USAGE.open("a", encoding="utf-8") as log:
        log.write(json.dumps({"at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                              "operation": operation, "exitCode": completed.returncode,
                              "seconds": round(time.monotonic() - started, 3)}) + "\n")
    if completed.returncode:
        raise SystemExit(completed.returncode)


def main():
    if len(sys.argv) < 2:
        raise SystemExit("Usage: scripts/graphify-local refresh | query TEXT | explain NAME | path A B | stats")
    operation, arguments = sys.argv[1], sys.argv[2:]
    if operation == "stats":
        graph = json.loads(GRAPH.read_text()) if GRAPH.exists() else {}
        events = [json.loads(line) for line in USAGE.read_text().splitlines()] if USAGE.exists() else []
        counts = collections.Counter(event["operation"] for event in events if event["exitCode"] == 0)
        print(json.dumps({"nodes": len(graph.get("nodes", [])),
                          "edges": len(graph.get("links", graph.get("edges", []))),
                          "version": graph.get("graph", {}).get("graphify_version"),
                          "sourceFiles": len({node.get("source_file") for node in graph.get("nodes", []) if node.get("source_file")}),
                          "communities": len({node.get("community") for node in graph.get("nodes", []) if node.get("community") is not None}),
                          "successfulOperations": dict(counts),
                          "operationSeconds": round(sum(event["seconds"] for event in events), 3),
                          "note": "Usage only; no measured time or token savings."}, ensure_ascii=False, indent=2))
        return
    if not CLI.exists():
        raise SystemExit("Graphify is not installed. See docs/graphify.md for local setup.")
    if operation == "refresh" and not arguments:
        run("extract", ["extract", str(ROOT), "--code-only", "--max-workers", "2", "--out", str(OUTPUT)])
        run("cluster", ["cluster-only", str(OUTPUT), "--no-label"])
    elif operation in {"query", "explain", "path"}:
        expected = 2 if operation == "path" else 1
        if len(arguments) != expected:
            raise SystemExit("Wrong number of arguments.")
        if not GRAPH.exists():
            raise SystemExit("Run scripts/graphify-local refresh first.")
        run(operation, [operation, *arguments, "--graph", str(GRAPH)])
    else:
        raise SystemExit("Unsupported operation.")


if __name__ == "__main__":
    main()
